# Supabase — Project Settings → API
# PUBLIC_SUPABASE_ANON_KEY = the "Publishable key" (client-safe; the "anon"
# key was renamed to this). Do NOT use a "Secret key" here — those are
# server-only and this app never needs one.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# DeepSeek — optional, only needed for AI scan / rate-lookup features
PUBLIC_DEEPSEEK_API_KEY=
